# Variables de entorno del backend (el .env real NUNCA se sube a GitHub).
# Spring Boot las lee al arrancar; si no existen usa valores de desarrollo.
# En PowerShell se definen así: $env:MYSQL_PASSWORD="tu_contraseña"
MYSQL_URL=jdbc:mysql://localhost:3306/ruta_fantasma?createDatabaseIfNotExist=true&serverTimezone=Europe/Madrid
MYSQL_USER=root
MYSQL_PASSWORD=
JWT_SECRETO=
