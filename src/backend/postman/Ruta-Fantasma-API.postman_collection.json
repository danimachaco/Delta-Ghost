              "path": [
                "api",
                "rutas",
                "{{rutaId}}",
                "sectores",
                "mejores"
              ]
            },
            "description": "Mejor tiempo de cada sector entre todos los corredores de la ruta y la vuelta ideal (la suma de todos)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Trae los 3 sectores', () => pm.expect(r.sectores).to.have.lengthOf(3));",
                  "pm.test('La vuelta ideal es la suma de los mejores sectores', () =>",
                  "  pm.expect(r.tiempoIdealSegundos).to.eql(r.sectores.reduce((total, s) => total + s.tiempoSegundos, 0)));"
                ]
              }
            }
          ]
