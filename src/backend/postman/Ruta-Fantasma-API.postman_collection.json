              ]
            },
            "description": "Sombra por tipo (PS-70): la mejor marca de todos los corredores de la ruta. También existen /sombra/propia y /sombra/amigo?amigoId=."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 200 OK', () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test('Es el récord de la ruta', () => {",
                  "  pm.expect(s.tipo).to.eql('record');",
                  "  pm.expect(s.tiempoTotalSegundos).to.eql(250);",
                  "});"
                ]
              }
            }
          ]
