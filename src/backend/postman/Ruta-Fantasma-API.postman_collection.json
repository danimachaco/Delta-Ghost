                  "pm.test('Es la ruta pedida', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('rutaId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "9. Crear ruta con datos incorrectos (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rutas",
              "host": [
