                ]
              }
            }
          ]
        },
        {
          "name": "14. Descargar la sombra",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/rutas/{{rutaId}}/sombra",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rutas",
                "{{rutaId}}",
                "sombra"
              ]
            },
            "description": "Devuelve la sombra de la ruta: la carrera subida en la petición 12 (250 s), con el tiempo de la sombra al final de cada sector."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 200 OK', () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test('La sombra es la carrera más rápida', () => pm.expect(s.tiempoTotalSegundos).to.eql(250));",
                  "pm.test('Trae los puntos de la sombra', () => pm.expect(s.puntos).to.have.lengthOf(4));",
                  "pm.test('Trae el tiempo de cada sector', () => pm.expect(s.sectores).to.have.lengthOf(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "21. Ranking de la ruta",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
