                "ranking"
              ]
            },
            "description": "Mejor marca de cada corredor en la ruta. Ana es la única que la ha corrido: primera con la carrera de 250 s."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Ana va primera con 250 s', () => {",
                  "  pm.expect(r.entradas[0].posicion).to.eql(1);",
                  "  pm.expect(r.entradas[0].tiempoTotalSegundos).to.eql(250);",
                  "  pm.expect(r.entradas[0].tuya).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
