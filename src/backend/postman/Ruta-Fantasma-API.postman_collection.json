              "mode": "raw",
              "raw": "{\n  \"puntos\": [\n    {\n      \"latitud\": 40.4153,\n      \"longitud\": -3.6845,\n      \"tiempoSegundos\": 0\n    },\n    {\n      \"latitud\": 40.417,\n      \"longitud\": -3.6858,\n      \"tiempoSegundos\": 80\n    },\n    {\n      \"latitud\": 40.4188,\n      \"longitud\": -3.6872,\n      \"tiempoSegundos\": 160\n    },\n    {\n      \"latitud\": 40.42,\n      \"longitud\": -3.689,\n      \"tiempoSegundos\": 250\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
